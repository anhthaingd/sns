# TUY CHON: chi can khi ban muon dung secret rieng (vd: khi deploy production).
# De chay dev binh thuong, KHONG can tao file .env - docker-compose da co san gia tri mac dinh.
#
# Cach dung: copy file nay thanh .env roi dien secret manh:
#   cp .env.example .env
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# --- Chi can khi deploy that (xem README muc 6) ---
# Bat khi chay sau HTTPS.
# COOKIE_SECURE=true
# Frontend va backend o hai domain khac nhau thi cookie refresh token can
# SameSite=None (chi hop le tren HTTPS).
# COOKIE_SAMESITE=none
# Muc mac dinh cua REGISTER_RATE_LIMIT_MAX la 60/gio/IP; docker-compose.yml dang
# noi long cho moi truong dev, deploy that nho bo dong do di.
