PORT=3000
DATABASE_URL=mongodb://localhost:27017/social_app

# Noi luu token da thu hoi + bo dem chong do mat khau.
# De trong thi app van chay nhung trang thai nam trong RAM tien trinh,
# tuc la dang xuat se mat hieu luc sau moi lan restart backend.
REDIS_URL=redis://localhost:6379/0

# Service tinh vector ngu nghia (thu muc embedder/).
# De trong thi he thong cham diem thuan luat, khong bao loi.
EMBEDDER_URL=http://localhost:8001

ACCESS_TOKEN_SECRET=your_secret_key_here
REFRESH_TOKEN_SECRET=your_refresh_secret_here

# Vong doi token (giay). Mac dinh: access 15 phut, refresh 7 ngay.
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800

# Thuoc tinh cookie refresh token - xem README muc 6.
# COOKIE_SECURE=false
# COOKIE_SAMESITE=lax

# Gioi han tan suat.
# LOGIN_FAIL_LIMIT_PER_EMAIL=10
# LOGIN_FAIL_LIMIT_PER_IP=30
# REGISTER_RATE_LIMIT_MAX=60

CLIENT_URL=http://localhost:5173
